# GroupMe Bot Configuration
BEERBOT_BOT_ID=your_groupme_bot_id_here
# Use a random secret and configure the callback as /callback?token=SECRET.
GROUPME_WEBHOOK_SECRET=replace_with_a_long_random_secret
REQUIRE_REGISTERED_GROUPS=true

# Neon PostgreSQL Connection
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/beerbot?sslmode=require

# Optional: Set to "development" for local testing
ENVIRONMENT=production

# Explicit model loop: google or openai_compatible.
LLM_PROVIDER=google
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=your_gemini_api_key_here
# LLM_BASE_URL=https://your-openai-compatible-endpoint.example/v1
# For compatible endpoints set LLM_MODEL to the server's model identifier.
# LLM_API_KEY is separate from GEMINI_API_KEY; keyless local servers are supported.
LLM_VIDEO_FORMAT=disabled
# Set video_url only for a compatible server that explicitly supports that format.
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_EXECUTED_TOOLS=20
LLM_SUPPORTS_IMAGES=true
LLM_SUPPORTS_VIDEO=true
LLM_SUPPORTS_TOOLS=true

# Backward-compatible Google key; LLM_API_KEY takes precedence.
GEMINI_API_KEY=your_gemini_api_key_here
ENABLE_IMAGE_ANALYSIS=true

# Build metadata exposed by /version.
APP_VERSION=0.2.0
GIT_SHA=unknown

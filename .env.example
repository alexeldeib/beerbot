# GroupMe Bot Configuration
BEERBOT_BOT_ID=your_groupme_bot_id_here

# Neon PostgreSQL Connection
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/beerbot?sslmode=require

# Optional: Set to "development" for local testing
ENVIRONMENT=production

# Optional: Gemini API key for image analysis (detect beers in photos)
GEMINI_API_KEY=your_gemini_api_key_here
ENABLE_IMAGE_ANALYSIS=true
